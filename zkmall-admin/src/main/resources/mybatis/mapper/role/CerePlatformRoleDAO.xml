    <select id="getAll" parameterType="com.shop.zkmall.admin.param.role.RoleGetAllParam"
            resultType="com.shop.zkmall.commons.domain.role.CerePlatformRole">
        SELECT role_id,role_name,role_describe FROM cere_platform_role
        where project=1
        <if test="search!=null and search!=''">
            and (role_name like concat('%',#{search},'%') or
            role_describe like concat('%',#{search},'%'))
        </if>
        ORDER BY update_time DESC,create_time DESC
