            resultType="com.shop.zkmall.commons.domain.role.CerePlatformRole">
        select a.role_id, role_name, role_describe, project
        from cere_platform_role a
        <if test="businessUserId != null">
            join cere_business_user_role b on b.role_id = a.role_id
        </if>
        where a.project = #{project}
        <if test="businessUserId != null">
            and b.business_user_id = #{businessUserId}
